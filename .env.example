PORT=3000
CORS_ORIGIN=http://localhost:4000
API_IMAGE=coguide-api
API_TAG=local
API_HOST_PORT=3002

DB_URI=mongodb://localhost:27017/coguide
JWT_SECRET=change-me
JWT_EXPIRES=7d

# LLM provider: groq | gemini
LLM_PROVIDER=groq
LLM_FALLBACK_TO_GROQ=false
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# RAG storage and retrieval
RAG_CHROMA_URL=http://localhost:8000
RAG_COLLECTION=rag
RAG_RAW_DIR=raw
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=100
RAG_AUTO_REINDEX=false
RAG_ADMIN_API_KEY=change-me-if-exposing-reindex
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=10
RAG_MAX_DISTANCE=1.2
RAG_MIN_CONFIDENCE_THRESHOLD=0.45
RAG_MIN_CHUNK_CHARS=220

# Embeddings provider: ollama | openai
RAG_EMBEDDING_PROVIDER=ollama
RAG_OLLAMA_EMBEDDING_MODEL=all-minilm
RAG_EMBED_BATCH_SIZE=8
OLLAMA_BASE_URL=http://localhost:11434
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Parser strategy: pdf | llama_parse
RAG_PARSER=pdf
LLAMA_PARSE_API_KEY=
LLAMA_PARSE_TIMEOUT_MS=600000
LLAMA_PARSE_INSTRUCTION=Extraia o conteúdo técnico preservando contexto e tabelas importantes.

# Optional observability (Phase 3)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
